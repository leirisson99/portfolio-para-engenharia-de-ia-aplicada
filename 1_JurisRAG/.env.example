# Banco de dados (PostgreSQL + pgvector, ver docker-compose.yml)
DATABASE_URL=postgresql://jurisrag:jurisrag@localhost:5432/jurisrag

# Modelo de geração (F4 — Pipeline RAG), via OpenRouter (API compatível com OpenAI)
# https://openrouter.ai/docs/quickstart
OPENROUTER_API_KEY=
# Catálogo completo: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Embeddings (F3) rodam localmente via sentence-transformers — não precisam de API key.

# Judge model do DeepEval (F6) — reaproveita o OPENROUTER_API_KEY acima (via
# OpenRouterModel nativo do DeepEval, compatível com a API da OpenAI).
# Modelo barato usado como Judge (RNF02); default se omitido: openai/gpt-4o-mini
AVALIACAO_JUDGE_MODEL=openai/gpt-4o-mini
